x="1" parent="1"><mxGeometry x="481" y="875" width="22" height="14" as="geometry"/></mxCell><mxCell id="lgt_ext" value="external" style="text;html=1;fontSize=13;fontColor=#3d4756;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="509" y="873" width="60" height="18" as="geometry"/></mxCell><mxCell id="lge_b" value="" style="endArrow=none;html=1;strokeColor=#1c2430;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="882" as="sourcePoint"/><mxPoint x="617" y="882" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lget_b" value="trust-boundary crossing (F4, F5)" style="text;html=1;fontSize=13;fontColor=#3d4756;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="623" y="873" width="234" height="18" as="geometry"/></mxCell><mxCell id="lge_r" value="" style="endArrow=none;html=1;strokeColor=#a2491f;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="867" y="882" as="sourcePoint"/><mxPoint x="899" y="882" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lget_r" value="TB3: to its own wallet&#x27;s internal APIs only" style="text;html=1;fontSize=13;fontColor=#a2491f;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="905" y="873" width="420" height="18" as="geometry"/></mxCell><mxCell id="foot" value="&lt;b&gt;Two kinds of wallet:&lt;/b&gt; the participant&#x27;s is its W-Stack tenant, which it alone fills by accepting offers (F1); people&#x27;s are in their phone or browser (F2, F3). The federation issues and publishes status lists; it never acts in a participant&#x27;s systems. Keycloak is not on the login path." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#3d4756;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="898" width="1560" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
