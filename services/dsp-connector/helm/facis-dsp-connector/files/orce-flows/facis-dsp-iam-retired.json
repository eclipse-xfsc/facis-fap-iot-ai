[
    {
        "id": "tab-dsp-iam-retired",
        "type": "tab",
        "label": "FACIS DSP — IAM retired routes (410)",
        "disabled": false,
        "info": "Compatibility stubs for the connector's former built-in identity tooling (self-issuer, identity hub, its own status list). Every former route answers 410 Gone with a JSON body. The connector is now a holder: its participant credential is issued by the federation issuer and kept in the connector's W-Stack tenant (storage), its presentations are signed by the tenant's crypto provider, and its did:web document is the tenant's."
    },
    {
        "id": "dsp-iam-retired-fn",
        "type": "function",
        "z": "tab-dsp-iam-retired",
        "name": "410 Gone",
        "func": "// 410 for every former identity route of the connector. The connector is a\n// holder now: its credential is in its W-Stack tenant's storage, its\n// presentations are signed by the tenant's crypto provider, and its did:web\n// document is served by the tenant.\nmsg.statusCode = 410;\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = {\n    error: 'retired',\n    reason: \"the connector's identity is held by its W-Stack tenant (credential storage, crypto provider, did:web); credentials are issued by the federation issuer\",\n    retired_route: msg.req && msg.req.url\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 200,
        "wires": [
            [
                "dsp-iam-retired-resp"
            ]
        ]
    },
    {
        "id": "dsp-iam-retired-resp",
        "type": "http response",
