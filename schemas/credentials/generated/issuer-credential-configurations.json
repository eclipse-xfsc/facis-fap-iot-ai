{
  "credential_configurations_supported": {
    "facis_participant_jwt": {
      "format": "jwt_vc_json",
      "scope": "facis_participant_jwt",
      "cryptographic_binding_methods_supported": [
        "jwk",
        "did:web",
        "did:key"
      ],
      "credential_signing_alg_values_supported": [
        "ES256"
      ],
      "credential_definition": {
        "@context": [
          "https://www.w3.org/2018/credentials/v1",
          "https://schemas.facis.example/v1/facis.context.jsonld"
        ],
        "type": [
          "VerifiableCredential",
          "FacisParticipantCredential"
        ]
      },
      "proof_types_supported": {
        "jwt": {
          "proof_signing_alg_values_supported": [
            "ES256"
          ]
        }
      },
      "credential_metadata": {
        "claims": [
          {
            "path": [
              "credentialSubject",
              "legalName"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "participantRoles"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "trustFramework"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "dspEndpoint"
            ],
            "mandatory": false
          }
        ],
        "display": [
          {
            "name": "FACIS Participant Credential",
            "locale": "en",
            "description": "Organisational credential of a FAP participant."
          }
        ]
      },
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^did:web:[A-Za-z0-9.%-]+(:[A-Za-z0-9._%-]+)*$",
            "description": "The organisation DID (did:web, keys in the TSA crypto provider). Also the DSP participantId and the org_did that the policy agent and Keycloak use."
          },
          "legalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Registered legal name of the organisation."
          },
          "participantRoles": {
            "type": "array",
            "items": {
              "enum": [
                "data_provider",
                "data_consumer"
              ]
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Dataspace-level roles of the organisation. Distinct from the person/service roles of FapIotAiRoleCredential."
          },
          "trustFramework": {
            "const": "FACIS",
            "description": "Trust framework the issuer attests under."
          },
          "dspEndpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "Optional: the participant's DSP protocol endpoint, so a counterparty can bind the credential to the connector it talks to."
          }
        },
        "required": [
          "id",
          "legalName",
          "participantRoles",
          "trustFramework"
        ],
        "additionalProperties": false
      },
      "topic": "fap.iotai.TENANT.facis_participant_jwt"
    },
