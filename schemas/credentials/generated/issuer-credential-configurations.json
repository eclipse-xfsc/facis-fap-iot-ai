    "fap_service_jwt": {
      "format": "jwt_vc_json",
      "scope": "fap_service_jwt",
      "cryptographic_binding_methods_supported": [
        "jwk",
        "did:web",
        "did:key"
      ],
      "credential_signing_alg_values_supported": [
        "ES256"
      ],
      "credential_definition": {
        "@context": [
          "https://www.w3.org/2018/credentials/v1",
          "https://schemas.facis.example/v1/facis.context.jsonld"
        ],
        "type": [
          "VerifiableCredential",
          "FapServiceCredential"
        ]
      },
      "proof_types_supported": {
        "jwt": {
          "proof_signing_alg_values_supported": [
            "ES256"
          ]
        }
      },
      "credential_metadata": {
        "claims": [
          {
            "path": [
              "credentialSubject",
              "org_did"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "serviceType"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "serviceName"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "roles"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "purposes"
            ],
            "mandatory": false
          }
        ],
        "display": [
          {
            "name": "FAP Service Credential",
            "locale": "en",
            "description": "Identity of a FAP machine client."
          }
        ]
      },
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^did:web:[A-Za-z0-9.%-]+(:[A-Za-z0-9._%-]+)*$",
            "description": "Service DID, a path below the organisation's did:web, e.g. did:web:<tenant>.<domain>:services:<serviceName>."
          },
          "org_did": {
            "type": "string",
            "pattern": "^did:web:[A-Za-z0-9.%-]+(:[A-Za-z0-9._%-]+)*$",
            "description": "DID of the organisation operating the service."
          },
          "serviceType": {
            "enum": [
              "dsp_connector",
              "nifi",
              "spark",
              "ai_processing",
              "ai_insight_service",
              "orce"
            ],
            "description": "Kind of machine client."
          },
          "serviceName": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
            "description": "Instance name, unique within the organisation (Kubernetes name rules)."
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "data_engineer",
                "data_analyst",
                "data_scientist",
                "operator",
                "administrator"
              ],
              "description": "Roles in the FAP IoT & AI. Used by people (FapIotAiRoleCredential) and machine clients (FapServiceCredential), so the policy agent and Keycloak see one vocabulary."
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "FAP roles granted to the service, from the same vocabulary as people."
          },
          "purposes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,48}$",
              "description": "A data-use purpose code. Starter vocabulary (see README): operations, analytics, research, ai_insight, maintenance."
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "org_did",
          "serviceType",
          "serviceName",
          "roles"
        ],
        "additionalProperties": false
      },
      "topic": "fap.iotai.TENANT.fap_service_jwt"
    },
