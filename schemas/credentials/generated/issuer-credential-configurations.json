    "fap_iotai_role_jwt": {
      "format": "jwt_vc_json",
      "scope": "fap_iotai_role_jwt",
      "cryptographic_binding_methods_supported": [
        "jwk",
        "did:web",
        "did:key"
      ],
      "credential_signing_alg_values_supported": [
        "ES256"
      ],
      "credential_definition": {
        "@context": [
          "https://www.w3.org/2018/credentials/v1",
          "https://schemas.facis.example/v1/facis.context.jsonld"
        ],
        "type": [
          "VerifiableCredential",
          "FapIotAiRoleCredential"
        ]
      },
      "proof_types_supported": {
        "jwt": {
          "proof_signing_alg_values_supported": [
            "ES256"
          ]
        }
      },
      "credential_metadata": {
        "claims": [
          {
            "path": [
              "credentialSubject",
              "name"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "email"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "org_did"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "roles"
            ],
            "mandatory": true
          },
          {
            "path": [
              "credentialSubject",
              "purposes"
            ],
            "mandatory": false
          }
        ],
        "display": [
          {
            "name": "FAP IoT & AI Role Credential",
            "locale": "en",
            "description": "Role of a person in the FAP IoT & AI."
          }
        ]
      },
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^did:(web|key):[A-Za-z0-9._%:-]+$",
            "description": "Holder DID (wallet key). Becomes 'sub' of the brokered login."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Display name. Selectively disclosable when SD-JWT is enabled."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Email address. Selectively disclosable when SD-JWT is enabled."
          },
          "org_did": {
            "type": "string",
            "pattern": "^did:web:[A-Za-z0-9.%-]+(:[A-Za-z0-9._%-]+)*$",
            "description": "DID of the participant organisation the person acts for; must be the subject of a valid FacisParticipantCredential. Mapped to the token claim org_did."
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "data_engineer",
                "data_analyst",
                "data_scientist",
                "operator",
                "administrator"
              ],
              "description": "Roles in the FAP IoT & AI. Used by people (FapIotAiRoleCredential) and machine clients (FapServiceCredential), so the policy agent and Keycloak see one vocabulary."
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "FAP roles. Mapped to realm roles and the token claim roles."
          },
          "purposes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,48}$",
              "description": "A data-use purpose code. Starter vocabulary (see README): operations, analytics, research, ai_insight, maintenance."
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Optional: purposes the person may declare. Mapped to the token claim purpose; evaluated by the policy agent for lakehouse and AI access. Not personal data."
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "org_did",
          "roles"
        ],
        "additionalProperties": false
      },
      "topic": "fap.iotai.TENANT.fap_iotai_role_jwt"
    },
